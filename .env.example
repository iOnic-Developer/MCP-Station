# ── Required ─────────────────────────────────────────────────────────────
# Password for the admin UI and the OAuth approval page.
APP_PASSWORD=change-me

# Public https base URL (no trailing slash). Enables the OAuth server so
# claude.ai can add each MCP as a custom connector.
PUBLIC_URL=https://mcp.dbzocchi.app

# ── Strongly recommended ─────────────────────────────────────────────────
SESSION_SECRET=
MCP_TOKEN=

# ── Assistant ─────────────────────────────────────────────────────────────
# OpenAI / GPT-6 Astra is the MCP Station 2.0 default.
# Keys can also be saved encrypted in Station settings. Env vars win when set.
ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com

# Optional alternate providers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ── Tuning ───────────────────────────────────────────────────────────────
PORT=8788
COOKIE_SECURE=1
DATA_DIR=/data
MCPS_DIR=/app/mcps
