{
  "name": "mcp-station",
  "version": "2.7.3-beta.1",
  "description": "Self-hosted hub that serves, configures and builds MCP servers \u2014 each hosted at its own path, with OAuth 2.1, a built-in multi-provider assistant, and import/export/backup.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "ASSISTANT_PROVIDER=anthropic bash scripts/smoke.sh",
    "test:openai": "bash scripts/smoke-openai.sh",
    "test:ui": "node scripts/check-ui.mjs",
    "test:oauth": "bash scripts/smoke-oauth.sh",
    "test:scoping": "bash scripts/smoke-scoping.sh",
    "test:selfcontained": "bash scripts/smoke-selfcontained.sh",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:instances": "node scripts/test-instances.mjs",
    "test:usage": "node scripts/test-usage.mjs",
    "test:workflows": "node scripts/test-workflows.mjs",
    "test:bundled": "node scripts/test-bundled.mjs",
    "test:configuration": "node scripts/test-configuration.mjs",
    "test:product-page": "REQUIRE_PRODUCT_SCREENSHOT=1 node scripts/test-product-page.mjs",
    "test:simple-create": "node scripts/test-simple-create.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  }
}
